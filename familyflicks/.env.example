# FamilyFlicks Environment Variables
# Copy this to .env.local and fill in your values.
# Never commit .env.local to source control.

# TMDB API key (public-facing, safe to expose in SPA)
# Get one free at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Google OAuth Client ID (public-facing, required for PKCE flow)
# Create at: https://console.cloud.google.com > APIs & Services > Credentials
# Recommended client type: "Desktop app" (no client_secret required)
# Add these Authorised Redirect URIs:
#   - http://localhost:5173/auth/callback  (local dev)
#   - https://your-app.vercel.app/auth/callback  (production)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google OAuth Client Secret — OPTIONAL
# Only needed if your OAuth client type is "Web application" rather than "Desktop app".
# If set, it is included in the token exchange request.
# Note: this value is visible in the browser bundle. Use "Desktop app" client type to avoid this.
VITE_GOOGLE_CLIENT_SECRET=

# Vercel serverless function for Claude API proxy (Step 7 replaced by rules-based engine — not used)
# CLAUDE_API_KEY=your_claude_api_key_here
